# ---------------------------------------------------------------------------
# Procedural Detective — PRODUCTION environment example (placeholders/defaults
# only). Copy to .env ONLY for a production deployment behind the shipped
# Caddy TLS edge:
#
#     copy .env.production.example .env       (Linux/macOS: cp ... .env)
#
# NEVER copy or use the DEV example (.env.example) for production: it carries
# ENVIRONMENT=development and TRUST_PROXY=false, which OVERRIDE the safe
# production defaults of docker-compose.prod.yml, disable production-only
# startup enforcement and collapse every client behind the Caddy edge into ONE
# shared per-IP rate-limit bucket (the app would see the Caddy peer, never the
# real client).
#
# Canonical names: REQUIREMENTS.md section 45. The backend treats UNKNOWN
# extra keys as unreachable (Settings is explicit-map), so every variable
# below is canonical.
# ---------------------------------------------------------------------------

# Production database: the durable pd-data volume (/data), NEVER inside the
# image. Migrations run automatically on container startup
# (docker/entrypoint.sh -> backend/app/startup.py runs `alembic upgrade head`
# BEFORE the server starts, then readiness reports ok).
DATABASE_URL=sqlite:////data/procedural_detective.db

# Deployment mode. PRODUCTION is mandatory for public hosting: it forces the
# PD-SEC-06 logging policy (PD_DEV_TRACE / PD_GENERATION_DEBUG_LOGS must be
# false). NEVER set ENVIRONMENT=development in a production .env — the
# release/preflight gate (python -m tools.prod_preflight) and
# (release_check.check_prod_effective_config) fail on it.
ENVIRONMENT=production

# Developer trace MUST stay off in production (PD-SEC-06). Production startup
# rejects the container if PD_DEV_TRACE=true here.
PD_DEV_TRACE=false

# ---------------------------------------------------------------------------
# TRUST_PROXY — Caddy-edge ONLY (Phase 21 P-01). NOT portable.
# ---------------------------------------------------------------------------
# true is VALID ONLY behind the SHIPPED Caddy TLS edge (docker-compose.prod.yml
# + docker/Caddyfile, which overwrite X-Forwarded-For on its private-network
# hop to the backend) or behind another ingress you have INDEPENDENTLY VERIFIED
# to (1) strip/overwrite hostile X-Forwarded-For, (2) provide a known hop
# structure and (3) preserve the correct client IP. Otherwise every client
# appears as the Caddy peer and all per-IP rate limits collapse into ONE shared
# bucket (PD-SEC-02 §6.2) — TRUST_PROXY=true is NOT portable between ingress
# providers. If you cannot prove the ingress, run with TRUST_PROXY=false and
# treat the edge peer as the only identity.
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Public edge (docker-compose.prod.yml -> Caddy). Operator fills these per
# host; the preflight ready-to-host verdict FAILS until CADDY_DOMAIN is a real
# (non-localhost, non-empty) public domain.
# ---------------------------------------------------------------------------
# CADDY_DOMAIN=detective.example.com
# CADDY_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# P-02 timeout envelope (docs/DEPLOYMENT.md §16). The strict chain is
#   provider timeout < remaining backend deadline < frontend request timeout
#                        < reverse-proxy timeout
# The FRONTEND abort (REQUEST_TIMEOUT_MS=360s, frontend/src/api/client.ts) and
# the CADDY upstream bound (response_header_timeout 420s, docker/Caddyfile)
# are fixed code constants. The maximum supported backend deadline is 300s —
# DO NOT raise it, or the browser aborts a request the backend still allows.
CASE_GENERATION_DEADLINE_SECONDS=300

# Max model/provider calls per generation attempt (runaway guard). Bounded.
MAX_LLM_CALLS_PER_GENERATION=128

# Phase 19 Fix C — hierarchical provider-budget ceilings (canonical §45 names).
# Generous-but-bounded: core stages and every procedural ASSET_SPEC object get
# their own hard ceiling; assets and failed assets are separately bounded.
MAX_CORE_LLM_CALLS_PER_GENERATION=12
MAX_LLM_CALLS_PER_PROCEDURAL_ASSET=5
MAX_PROCEDURAL_ASSETS_PER_GENERATION=20
MAX_FAILED_ASSETS_PER_GENERATION=3
# Effective asset concurrency is always 1 today (architecturally sequential);
# recorded for a later measured optimization. Must NOT enable parallel execution.
MAX_PARALLEL_ASSET_GENERATIONS=2

# Phase 19E — CONFIGURABLE TOTAL VISIBLE OBJECT BOUND per published scene
# (NOT a provider budget; the procedural-asset sub-budgets stay authoritative).
# DECORATIVE objects beyond the bound are dropped deterministically; REQUIRED /
# evidence-relevant objects are never dropped for it.
MAX_WORLD_OBJECTS_PER_KIT=32

# Max repair passes / full regenerations per attempt (recovery budgets).
MAX_REPAIR_PASSES=2
MAX_FULL_REGENERATIONS=1

# Concurrency / admission limits (public deployment values, PD-SEC-02).
MAX_CONCURRENT_GENERATIONS=1
MAX_CONCURRENT_GENERATIONS_GLOBAL=2
MAX_GENERATIONS_PER_SESSION_PER_WINDOW=3
MAX_GENERATIONS_GLOBAL_PER_WINDOW=20
GLOBAL_GENERATION_WINDOW_SECONDS=60

# Phase 20 public admission rate limiting (PD-SEC-02). Identity is the
# TRUST_PROXY-aware resolved client IP (TRUST_PROXY=true above -> real clients
# behind the Caddy edge).
ANON_SESSION_LIMIT_PER_IP_PER_10_MIN=10
ANON_SESSION_GLOBAL_LIMIT_PER_MIN=100
GENERATION_LIMIT_PER_IP_PER_HOUR=10

# Phase 21 F-02 — bounded playthrough admission (durable-table DoS). ACTIVE =
# {CREATED, PLAYING}; a new create above the cap is REJECTED (429), no row,
# no token. Total rows kept per case are bounded and the create garbage-
# collects only the OLDEST COMPLETED rows.
MAX_ACTIVE_PLAYTHROUGHS_PER_CASE=4
MAX_RETAINED_PLAYTHROUGHS_PER_CASE=12
PLAYTHROUGH_CREATE_LIMIT_PER_CREATOR=25
PLAYTHROUGH_CREATE_LIMIT_PER_IP=50

# Input bounds.
MAX_PROMPT_CHARS=4000
MAX_REQUEST_BODY_SIZE=65536

# Anonymous quota session / token TTLs (bounds only; no real tokens in this
# file).
ANONYMOUS_QUOTA_SESSION_TTL_SECONDS=86400
CREATOR_TOKEN_TTL_SECONDS=86400
PLAYTHROUGH_TOKEN_TTL_SECONDS=14400

# Provider selection for a public deployment: "fake" (deterministic demo —
# DEFAULT, zero credentials/zero cost), "live" or "ollama" (both opt-in). A
# public build showing the demo CTA stays honest only when GENERATION_PROVIDER
# matches what the backend actually runs.
GENERATION_PROVIDER=fake

# Optional explicit path to a .env file. When unset, the backend also looks for
# <repo-root>/.env. In the container the compose env_file already injects .env.
ENV_FILE=

# Production static serving: the shipped Dockerfile sets /app/static and the
# backend serves the SPA at "/" with index.html fallback.
STATIC_DIR=/app/static

# ---------------------------------------------------------------------------
# Frontend API base — SAME-ORIGIN ONLY (PD-SEC-04).
# ---------------------------------------------------------------------------
# In production the built SPA calls the API at the RELATIVE /api/v1 root from
# the current browser origin. Do NOT set VITE_API_BASE_URL here: an absolute
# http://localhost:8000 baked into a production build is an audited leak that
# FAILS the release/preflight bundle scan.
# VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Phase 20 — Privacy & retention (PD-SEC-05). OPERATOR NOTICE.
# ---------------------------------------------------------------------------
# Generated cases persist the raw prompt, public case, hidden CaseTruth,
# generation metadata and player state in the SQLite database on the /data
# volume. There is NO automatic deletion: data is retained until the OPERATOR
# deletes it. Full policy, operator deletion + backup procedures:
# docs/PRIVACY.md + docs/OPERATIONS.md. Keep the database volume private
# (never expose /data, never mount it into a Docker build context).