# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller one-file spec for the ``pd-ollama-bridge`` standalone client.

Phase 49 Sec.8/Sec.12/Sec.35. This spec is invoked identically by the native Windows
build (``build-bridge-windows.ps1``) and the Docker Linux build
(``bridge/Dockerfile.release``), so both platforms converge on the same
entry point, hidden imports and data files.

Determinism / portability:

- No absolute personal path is hard-coded. The only directory used is
  ``SPECPATH`` (the directory containing this spec, i.e. ``bridge/``), which
  PyInstaller defines when it evaluates the spec.
- The package's own ``pd_ollama_bridge/__main__.py`` uses a *relative* import
  (``from .cli import main``). A frozen entry script is executed as
  ``__main__`` with no parent package, so that relative import cannot resolve.
  We therefore generate a tiny, deterministic launcher that uses an ABSOLUTE
  import inside PyInstaller's build work path (``workpath``) instead of adding
  a launcher file to the bridge source tree.

Output: ``dist/pd-ollama-bridge.exe`` (Windows) / ``dist/pd-ollama-bridge``
(Linux), one file, console application.
"""

import certifi

# ``SPECPATH`` and ``workpath`` are provided by PyInstaller when it executes a
# spec file. ``SPECPATH`` is the directory holding this spec (``bridge/``).
_spec_dir = os.path.normpath(SPECPATH)  # noqa: F821 (injected by PyInstaller)
_work_dir = os.path.normpath(workpath)  # noqa: F821 (injected by PyInstaller)

# Deterministic absolute-import launcher, generated into the (throwaway) build
# work path so nothing pollutes the source tree.
_launcher = os.path.join(_work_dir, "_pd_ollama_bridge_entry.py")
with open(_launcher, "w", encoding="utf-8", newline="\n") as _fh:
    _fh.write(
        '"""Generated by pd-ollama-bridge.spec -- do not edit."""\n'
        "from pd_ollama_bridge.cli import main\n"
        "\n"
        "if __name__ == '__main__':\n"
        "    raise SystemExit(main())\n"
    )

# Phase 49 contract: the bridge dev's recommended hidden imports. ``websockets``
# and ``httpcore`` load several submodules lazily/dynamically, so PyInstaller's
# static analysis cannot see them. The normally-auto ones are listed explicitly
# so the bundle cannot regress if an upstream hook changes. A missing optional
# module (e.g. ``anyio`` when it is not installed) only warns and does not fail
# the build.
HIDDEN_IMPORTS = [
    "websockets",
    "websockets.asyncio.client",
    "websockets.asyncio.connection",
    "websockets.legacy.client",
    "websockets.exceptions",
    "httpx",
    "httpcore",
    "httpcore._backends.auto",
    "certifi",
    "sniffio",
    "idna",
    "anyio._backends._asyncio",
]

# certifi needs its CA bundle on disk at runtime; ship it as ``certifi/cacert.pem``.
DATAS = [(certifi.where(), "certifi")]


a = Analysis(  # noqa: F821 (Analysis is injected by PyInstaller)
    [_launcher],
    pathex=[_spec_dir],
    binaries=[],
    datas=DATAS,
    hiddenimports=HIDDEN_IMPORTS,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)

pyz = PYZ(a.pure)  # noqa: F821

exe = EXE(  # noqa: F821
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="pd-ollama-bridge",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
