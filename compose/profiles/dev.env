# Provider + feature flags.
GENERATION_PROVIDER=fake
ENABLE_BRIDGE=false

# Local development markers.
ENVIRONMENT=development
TRUST_PROXY=false

# Canonical timeout envelope (same 300/180 numbers as prod- and CI profiles).
CASE_GENERATION_DEADLINE_SECONDS=300
OLLAMA_TIMEOUT_SECONDS=180