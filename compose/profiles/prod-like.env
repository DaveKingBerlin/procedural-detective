# ---------------------------------------------------------------------------
# Procedural Detective — PRODUCTION-LIKE LOCAL SMOKE profile (Phase 24 §8/§38).
#
# A FAIL-CLOSED local emulation of the production deployment, run through the
# canonical production compose and canonical preflight:
#
#     docker compose --env-file compose/profiles/prod-like.env \
#       -f docker-compose.prod.yml up --build -d
#     python -m tools.prod_preflight --allow-local
#
# Uses the shipped Caddy edge on https://localhost (internal CA) and the
# deterministic fake provider — the exact stack the GitLab docker/smoke stage
# boots with a local/test CADDY_DOMAIN. Production preflight still REJECTS a
# placeholder domain without --allow-local — CI explicitly passes it because
# this is a local smoke, never a ready-to-host certification.
# ---------------------------------------------------------------------------

# Deterministic offline smoke (never a real provider on an ordinary pipeline).
GENERATION_PROVIDER=fake
ENABLE_BRIDGE=false

# Production markers (the same the real deployment uses).
ENVIRONMENT=production
PD_DEV_TRACE=false
TRUST_PROXY=true

# Local/TEST edge domain ONLY for this local profile. A real public release
# MUST override CADDY_DOMAIN/CADDY_EMAIL with a public domain (GitLab CI/CD
# variables or the operator's environment) — never committed.
CADDY_DOMAIN=localhost

# Canonical timeout envelope (matches docker-compose.prod.yml 300/180).
CASE_GENERATION_DEADLINE_SECONDS=300
OLLAMA_TIMEOUT_SECONDS=180