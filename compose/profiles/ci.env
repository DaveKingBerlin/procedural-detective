# ---------------------------------------------------------------------------
# Procedural Detective — CI DETERMINISTIC profile (Phase 24 §8).
#
# Invoke with the development compose:
#
#     docker compose --env-file compose/profiles/ci.env \
#       -f docker-compose.yml up --build
#
# Hermetic, deterministic, zero-credential, zero network calls:
#   GENERATION_PROVIDER=fake   (golden demo world; no real AI, no budget risk)
#   ENABLE_BRIDGE=false        (BYO-Ollama bridge REST/WS surface turned off)
#
# This is the profile GitLab runs for every ordinary push/MR pipeline. It
# NEVER sets OLLAMA_BASE_URL / OLLAMA_MODEL / LLM_API_KEY and MUST stay free
# of private addresses — the real-Ollama profile is operator-injected only.
# ---------------------------------------------------------------------------

# Provider + feature flags (canonical Phase 24 §8 CI deterministic contract).
GENERATION_PROVIDER=fake
ENABLE_BRIDGE=false

# Deployment marker: LEAN deterministic CI (development semantics, no
# PD-SEC-06 production enforcement for the smoke container).
ENVIRONMENT=development
TRUST_PROXY=false

# Phase 19J-RI2 canonical timeout envelope (the SAME 300/180 profile the
# docker-compose.prod.yml declares): fake ignores the deadline, but rendering
# the canonical envelope here means the CI/compose gate validates the SAME
# numbers everywhere (docs/DEPLOYMENT.md §16).
CASE_GENERATION_DEADLINE_SECONDS=300
OLLAMA_TIMEOUT_SECONDS=180

# No credentials — there are never any to inject. Real-AI values belong ONLY
# to GitLab CI/CD variables (masked/protected) on the real-ollama runner.