# ---------------------------------------------------------------------------
# Procedural Detective — REAL-OLLAMA ACCEPTANCE profile (Phase 24 §8).
#
# This file is DOCUMENTATION ONLY — it must NEVER contain a real base URL,
# host, token or private address. It exists so an OPERATOR can reproduce the
# real-AI acceptance configuration on a tagged `real-ollama` runner by
# injecting the private values from GitLab CI/CD variables / their own
# environment (masked/protected, NEVER committed, NEVER echoed).
#
#     export OLLAMA_BASE_URL=<private-ollama-endpoint>  # operator environment
#     export OLLAMA_MODEL=hermes3:8b                    # operator environment
#     GENERATION_PROVIDER=ollama                        # force the real path
#     python -m tools.real_ollama_regression --matrix
#
# The real-Ollama values are deliberately NOT present below. When
# GENERATION_PROVIDER=ollama and Ollama is unreachable the product FAILS
# TRUTHFULLY and typed — there is NO silent fallback to FakeProvider.
# ---------------------------------------------------------------------------

# Force the REAL provider (acceptance mode). If unset, the tools refuse with a
# typed error instead of silently falling back to the deterministic demo.
GENERATION_PROVIDER=ollama

# BYO-Ollama bridge stays disabled for the server-local acceptance test.
ENABLE_BRIDGE=false

# Canonical timeout envelope for the supported real profile (300/180).
CASE_GENERATION_DEADLINE_SECONDS=300
OLLAMA_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Private operator values (set in the runner environment / GitLab CI/CD
# variables, NEVER in this file):
#
#   OLLAMA_BASE_URL   -- the private endpoint of the real Ollama host
#   OLLAMA_MODEL      -- e.g. hermes3:8b
# ---------------------------------------------------------------------------