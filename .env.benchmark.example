# Benchmark credentials — copy to .env.benchmark
# Never commit the real file (.env.benchmark is git-ignored).
#
# Only the trusted providers the repository actually supports appear here.
# Leave every variable empty until the operator fills in a real key.
# The benchmark runner loads credentials ONLY from the process environment or
# .env.benchmark — never from CLI arguments, never from tracked files.

# OpenRouter (default proxy for the canonical benchmark contestants)
OPENROUTER_API_KEY=

# OpenAI (Luna baseline is currently BLOCKED-EXTERNAL — no official API id)
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# DeepInfra
DEEPINFRA_API_KEY=

# xAI
XAI_API_KEY=