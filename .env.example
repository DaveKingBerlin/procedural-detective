# ---------------------------------------------------------------------------
# Procedural Detective — environment example (placeholders/defaults only).
# Copy to .env and adjust locally. NEVER commit real credentials.
# Canonical names: REQUIREMENTS.md section 45 ("exactly one canonical
# configuration name per setting").
# ---------------------------------------------------------------------------

# SQLAlchemy database URL (SQLite for local development). When unset, the
# backend automatically uses <repo-root>/procedural_detective.db (an absolute,
# working-directory-independent file) — so this line is optional. Provide any
# SQLAlchemy URL if you need a different location/engine:
# DATABASE_URL=sqlite:///path/to/your/procedural_detective.db
#
# PRODUCTION (single container, Phase8 I/J): the container defaults to a
# persistent, DOCKER-VOLUME-BACKED path — never a location inside the image:
#   DATABASE_URL=sqlite:////data/procedural_detective.db
# The /data volume survives rebuilds/restarts; migrations run automatically on
# container startup (docker/entrypoint.sh -> backend/app/startup.py runs
# `alembic upgrade head` BEFORE the server starts, then readiness reports ok).

# ASGI bind host/port (uvicorn). The container sets these itself.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated CORS allowlist. Local development default below; a later
# single-origin deployment replaces this with the production origin.
# NOTE: '*' and 'null' are rejected at configuration time — credentials are
# enabled, so reflecting arbitrary origins would be unsafe.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production single-origin note: when the container serves BOTH the SPA and
# the API from the same origin (the shipped Docker/STATIC_DIR setup), CORS is
# moot for same-origin browser requests — the browser never sends a preflight
# to the origin it loaded the page from. If you host the UI separately, set
# this to EXACTLY the deployed UI origin, e.g.:
# CORS_ALLOWED_ORIGINS=https://demo.example.com

# Optional explicit path to a .env file. When unset, the backend also looks for
# <repo-root>/.env. A .env file is never required.
ENV_FILE=

# ---------------------------------------------------------------------------
# Phase 4 generation lifecycle (REQUIREMENTS section 45 canonical names).
# One canonical name per setting; defaults below match the generated config.
# ---------------------------------------------------------------------------

# Total generation deadline in seconds (deadline covers generation, retries,
# repairs and regenerations of ONE attempt). This is the ONLY deadline env
# name the backend reads (canonical §45 single name; GENERATION_DEADLINE_SECONDS
# is NOT read — set this one, e.g. to 900 for slow real-model WAN attempts).
# The product default is 60. Recommended showcase baseline (local Ollama):
#   300 seconds (Phase 19 §12). NOTE: 600 is a FUTURE supported ceiling for
# 10-20 procedural-asset worlds — NOT the default; do not raise it without
# measuring current Easy/Medium/Hard behavior.
#
# P-02 TIMEOUT ENVELOPE (Phase 21): the strict chain is
#   provider timeout < remaining backend deadline < frontend request timeout
#                        < reverse-proxy timeout
# with explicit margins — see docs/DEPLOYMENT.md § timeout envelope. The
# FRONTEND abort (REQUEST_TIMEOUT_MS=360s in frontend/src/api/client.ts) and
# the CADDY upstream bound (response_header_timeout 420s in docker/Caddyfile)
# are fixed constants; DO NOT raise this deadline above 300s, or the browser
# can abort a request the backend still legitimately allows. The provider
# call timeout is clamped to the remaining deadline minus 0.1s, so a 300s
# timeout with a 300s deadline still satisfies "provider < deadline".
CASE_GENERATION_DEADLINE_SECONDS=300

# Max model/provider calls per generation attempt. Phase 19 Fix C: this is now
# the GLOBAL SAFETY CEILING (a local Ollama call has no per-call charge, so the
# ceiling is a runaway guard, not a target). Recommended showcase baseline: 128.
MAX_LLM_CALLS_PER_GENERATION=128

# Phase 19 Fix C — hierarchical provider-budget ceilings (all canonical §45
# names). Core stages (case_truth / evidence / world_requirements +
# repair/regeneration) get their own hard ceiling; every procedural ASSET_SPEC
# object gets an independent per-asset allowance; the number of procedural
# assets and of failed assets per generation are separately bounded.
MAX_CORE_LLM_CALLS_PER_GENERATION=12
MAX_LLM_CALLS_PER_PROCEDURAL_ASSET=5
MAX_PROCEDURAL_ASSETS_PER_GENERATION=20
MAX_FAILED_ASSETS_PER_GENERATION=3
# Effective asset concurrency is always 1 today (the generation architecture is
# strictly sequential); this setting is recorded now for a later measured
# optimization and must NOT be treated as enabling parallel execution.
MAX_PARALLEL_ASSET_GENERATIONS=2

# Max repair passes per attempt (recovery budget).
MAX_REPAIR_PASSES=2

# Max full regenerations per attempt (recovery budget).
MAX_FULL_REGENERATIONS=1

# Concurrency / admission limits.
MAX_CONCURRENT_GENERATIONS=1
# Phase 20 PD-SEC-02: the shipped default was audited (was 3) and aligned to
# the security-phase recommendation of 2 for a public deployment.
MAX_CONCURRENT_GENERATIONS_GLOBAL=2
MAX_GENERATIONS_PER_SESSION_PER_WINDOW=3
MAX_GENERATIONS_GLOBAL_PER_WINDOW=20

# Phase 20 PD-SEC-02 — rolling duration of the global generation quota window.
# When the current time reaches the window end the admission controller starts
# a fresh window and resets the rolled counters atomically (never
# reject-forever after an expiry; 60s is a sensible public default).
GLOBAL_GENERATION_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Phase 20 — public admission rate limiting (PD-SEC-02). Canonical env names.
# ---------------------------------------------------------------------------
# POST /sessions/anonymous is a bounded public admission point:
#   - per-client-IP rolling window (10 sessions per IP per 10 minutes);
#   - global ceiling (100 anonymous sessions per minute across all peers).
# Identity is the TRUST_PROXY-aware resolved client IP (see TRUST_PROXY below).
ANON_SESSION_LIMIT_PER_IP_PER_10_MIN=10
ANON_SESSION_GLOBAL_LIMIT_PER_MIN=100

# POST /cases per-IP generation budget (rolling 1-hour window). This bounds
# generation on top of the existing per-session budget, the global concurrency
# ceiling and the rolling global quota — minting fresh sessions can never reset
# the per-IP budget. Failed generations count as ATTEMPTED generations
# (reservation-attempts policy, PD-SEC-02 §8.2 item 9).
GENERATION_LIMIT_PER_IP_PER_HOUR=10

# Trusted proxy handling (PD-SEC-02 §6.2). DEFAULT FALSE: forwarded headers
# (X-Forwarded-For / Forwarded / X-Real-IP) are NEVER honored for rate-limit
# identity; the direct socket peer address is always used, so a hostile
# X-Forwarded-For header can never bypass a per-IP limit.
#
# Set TRUST_PROXY=true ONLY when the deployment runs behind the documented
# trusted TLS reverse proxy (Internet -> HTTPS edge -> private Uvicorn) and the
# single trusted edge is the ONLY path to the backend. In that mode the
# LEFT-MOST X-Forwarded-For entry is honored as the original client IP (each
# trusted proxy appends the previous hop, so left = original client; a
# multi-hop chain with any untrusted hop must keep TRUST_PROXY=false).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Phase 21 F-02 — bounded playthrough admission (durable-table DoS).
# Canonical env names. Enforced ATOMICALLY inside the create transaction per
# pinned (caseId, caseVersion).
# ---------------------------------------------------------------------------
# ACTIVE = state in {CREATED, PLAYING} (non-terminal). Above this cap a new
# POST .../playthroughs is REJECTED (429 PLAYTHROUGH_LIMIT_EXCEEDED): no row,
# no token, existing playthroughs preserved.
MAX_ACTIVE_PLAYTHROUGHS_PER_CASE=4
# Total rows kept per case (all states). Above this ceiling the create first
# garbage-collects the OLDEST COMPLETED ({ACCUSED, REVEALED}) rows (bounded,
# never active rows) so the new one fits; when not enough completed rows exist
# the create is rejected (case at capacity).
MAX_RETAINED_PLAYTHROUGHS_PER_CASE=12
# Optional creation budgets (in-memory rolling 1-hour windows; single-process,
# like the Phase 20 rate state):
#   per creator credential across ALL cases (keyed on the SHA-256 verifier —
#   the raw token/identity is never stored) and
#   per TRUST_PROXY-aware resolved client IP (resolve_client_ip).
PLAYTHROUGH_CREATE_LIMIT_PER_CREATOR=25
PLAYTHROUGH_CREATE_LIMIT_PER_IP=50

# Input bounds.
MAX_PROMPT_CHARS=4000
MAX_REQUEST_BODY_SIZE=65536

# Anonymous quota session TTL (the stable quota identity window).
ANONYMOUS_QUOTA_SESSION_TTL_SECONDS=86400

# Phase 5 auth token TTLs (REQUIREMENTS section 45 canonical names).
# These are TTL bounds only — no real tokens/values are configured here.
CREATOR_TOKEN_TTL_SECONDS=86400
PLAYTHROUGH_TOKEN_TTL_SECONDS=14400

# Provider selection: "fake" (deterministic demo — DEFAULT; deterministic,
# offline, zero credentials/zero cost), "live" (opt-in real LLM calls) or
# "ollama" (opt-in LOCAL AI via a local Ollama server).
#
# DEMO MODE (hackathon default): GENERATION_PROVIDER=fake. Every prompt yields
# the same logically-validated golden case from the shipped dev-mode script.
# No LLM_API_KEY needed anywhere. This is the zero-cost zero-credential path
# the public demo runs on. Deterministic, offline, no local model required.
#
# LOCAL AI MODE (opt-in, Phase 16.2): set GENERATION_PROVIDER=ollama with a
# local Ollama running the configured Llama 3.2 model. The backend runs its
# generative Prompt-to-World pipeline through the Ollama stage driver: the
# model PROPOSES structured case/evidence/world data; deterministic validators,
# the deduction solver, the Asset Oracle and the procedural renderer verify and
# construct the playable investigation. The model never proves the case and
# never runs generated code. Example:
#   GENERATION_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=llama3.2:3b
# When Ollama is unavailable the UI shows "Local AI unavailable"; it never
# silently switches to Demo — Demo remains a separate selectable mode.
#
# Phase 17 GEOMETRY QUALITY GATE: local models may produce structurally correct
# but geometrically implausible object descriptions (25 meters instead of 25
# centimeters, parts parked metres away from a small object, all parts stacked
# at one origin). Procedural Detective therefore performs a deterministic
# geometry-quality check after the strict schema/security validation and can
# automatically request a bounded ASSET_SPEC_REPAIR (at most 2 per object)
# BEFORE an object is compiled into the world. The LLM proposes the object;
# Procedural Detective verifies its geometry before allowing it into the scene.
#
# CLOUD AI MODE (opt-in, HTTPS-only): set GENERATION_PROVIDER=live and provide
# all three below (the browser never talks to the provider directly; only the
# backend does, over HTTPS).
GENERATION_PROVIDER=fake

# Live provider credentials — NEVER commit a real key. Absence must not affect
# fake mode or the test suite.
# LLM_API_KEY=
# LLM_MODEL=
# LIVE_PROVIDER_URL=https://api.example.com/v1/chat/completions

# ---------------------------------------------------------------------------
# Phase 16 — LOCAL AI (Ollama) provider (operator configuration only).
# OLLAMA_BASE_URL is never taken from a prompt/request and never emitted to
# player DTOs or logs. Only loopback, private/LAN and host.docker.internal
# hosts are accepted (public internet hosts are rejected by default).
# ---------------------------------------------------------------------------
#
# Documented configurations (no developer-specific IP is hardcoded anywhere):
#
# Native backend (recommended local dev):
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Desktop (backend in a container, Ollama on the host):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# LAN (Ollama on another machine on your private network):
#   OLLAMA_BASE_URL=http://<private-host>:11434
#
# When OLLAMA_BASE_URL is unset and GENERATION_PROVIDER=ollama, the documented
# default http://127.0.0.1:11434 is used.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local model name/tag (1..80 chars, [A-Za-z0-9._:-] only).
# OLLAMA_MODEL=llama3.2:3b

# Per-call timeout in seconds (5..300), independently clamped to the remaining
# generation deadline before each provider call.
# Local Hermes showcase: keep the provider timeout distinct from the 300s
# generation deadline. Each call is clamped to the remaining deadline.
# P-02 envelope: OLLAMA_TIMEOUT_SECONDS (5..300) is ALWAYS below the backend
# deadline in effect because BudgetTracker.effective_provider_timeout clamps it
# to remaining_deadline - 0.1s — and both stay below the frontend 360s and the
# Caddy 420s bounds (docs/DEPLOYMENT.md § timeout envelope).
OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_TEMPERATURE=0.2

# Optional sanitized lifecycle logging. The demo launcher enables a bounded
# rotating file automatically; normal runs default to console-only logging.
PD_LOG_LEVEL=INFO
PD_GENERATION_DEBUG_LOGS=false
PD_FILE_LOGS=false
# PD_LOG_FILE=logs/procedural-detective.log

# Phase 20 PD-SEC-06 — deployment environment marker
# (development|production|test, default development). When ENVIRONMENT=production
# the backend REJECTS startup if PD_DEV_TRACE=true OR PD_GENERATION_DEBUG_LOGS=true
# (development tracing must never leak provider content into a public build).
ENVIRONMENT=development

# Optional bounded context/token setting (512..32768).
# OLLAMA_NUM_CTX=4096

# Optional JSON file driving the deterministic fake provider
# (generation-stage -> list of directives/strings). Absolute or repo-relative.
# FAKE_PROVIDER_SCRIPT=

# Production static serving: set to the directory containing the built
# frontend (index.html + assets). The shipped Dockerfile sets
# STATIC_DIR=/app/static and the backend then serves the SPA at "/" with
# index.html fallback for /scene /accuse /reveal. Unset in local dev (Vite
# serves the frontend on :5173).
# STATIC_DIR=/app/static

# ---------------------------------------------------------------------------
# Frontend (Vite) — base URL of the backend API.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Frontend (Vite) — app-provider DISPLAY mode (Phase 15 demo-mode UI).
# Baked into the SPA at build time. Controls only the honest one-line note
# beside the "Generate a New Mystery" path: "live" shows "Live AI provider";
# any other value (or absence — the DEFAULT) keeps the honest
# "uses the built-in deterministic generator in this demo build".
# NOTE: this NEVER changes the generation mechanics — the browser journey is
# identical either way; the backend GENERATION_PROVIDER decides the provider.
# Keep in sync with the backend GENERATION_PROVIDER when deploying live.
# VITE_APP_PROVIDER=fake

# ---------------------------------------------------------------------------
# Phase 20 — Privacy & retention (PD-SEC-05). OPERATOR NOTICE.
# ---------------------------------------------------------------------------
# Generated cases persist the raw prompt, public case, hidden CaseTruth,
# generation metadata and player state in the SQLite database on the /data
# volume. There is NO automatic deletion: data is retained for the duration of
# the hackathon/demo period and is then deleted by the OPERATOR. Full policy,
# operator deletion + backup procedures: docs/PRIVACY.md.
# Hygiene guidance: keep the database volume private (never expose /data),
# never mount it into a Docker build context, and wipe the environment
# (docker compose -f docker-compose.prod.yml down -v) before handing it over
# or at the end of the demo period.

# ---------------------------------------------------------------------------
# Phase 20 — production deployment profile (PD-SEC-03/06; see DEPLOYMENT.md).
# ---------------------------------------------------------------------------
# ENVIRONMENT: deployment mode. The production compose profile defaults this
# to "production" (forces safe production defaults, e.g. PD_DEV_TRACE=false).
# TRUST_PROXY: honor proxy-forwarded client IPs ONLY when the deployment runs
# behind the defined trusted reverse proxy (the shipped Caddy TLS edge sets
# it). Leave false unless you can name exactly the trusted proxy path.
# ENVIRONMENT=development
# TRUST_PROXY=false
